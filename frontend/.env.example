# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* values at build time,
# so these end up in the app bundle: only use keys that are safe to ship
# (Supabase anon key with row-level security on, restricted API keys).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STREAM_API_KEY=
EXPO_PUBLIC_OPENWEATHER_API_KEY=
